#!/bin/bash
set -euo pipefail
set -x

cargo nextest run --no-fail-fast "$@"

# T072: L3 PTY end-to-end (opt-out with ZEN_SKIP_PTY=1). Complements the
# headless L1/L2 suites above with real-escape-sequence verification.
if [[ "${ZEN_SKIP_PTY:-0}" == "1" ]]; then
  echo "bin/test: PTY layer skipped (ZEN_SKIP_PTY=1)"
else
  bin/tui-pty-test
fi
