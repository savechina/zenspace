#!/bin/bash
set -euo pipefail
set -x

# bbtree Guard-3 verification gate: Verus proofs + deterministic simulation
# + runtime congruence pins. One command for local and CI (verify.yml calls
# these targets instead of duplicating cargo commands):
#   (default) / all  full gate: verus → dst → pins
#   formal           Verus proofs + congruence pins (no shuttle sweeps)
#   verus            just the Verus proof pass (needs the pinned toolchain)
#   dst              just the deterministic shuttle sweeps
#   pins             just the plain-cargo congruence pins
#   --verus-only     alias of `verus` (kept for compatibility)
#
# Toolchain pin: formal/verus.json (version + vstd + asset sha256) — installed
# by the "Install pinned Verus toolchain" step in .github/workflows/verify.yml;
# locally: unzip the pinned release into ~/.verus + `rustup toolchain install
# <rustup_toolchain>`.
cd "$(dirname "$0")/.."

PIN_VERSION=$(python3 -c "import json;print(json.load(open('formal/verus.json'))['version'])")

verus_gate() {
    export PATH="$HOME/.verus:$PATH"
    command -v verus >/dev/null || {
        echo "verus not found — install the pinned release from formal/verus.json into ~/.verus" >&2
        return 1
    }
    # Capture once, then compare — never run the fallback inside the message
    # (unquoted '<...>' there is shell redirection, not text).
    local got
    got=$(verus --version 2>&1 || true)
    printf '%s\n' "$got" | grep -q "$PIN_VERSION" || {
        echo "verus version mismatch: want $PIN_VERSION, got: ${got:-no output} — reinstall the pinned release from formal/verus.json" >&2
        return 1
    }
    cargo verus verify --manifest-path formal/Cargo.toml
}

dst_gate() {
    # Tier 1: FR-009 TUI event forwarder (broadcast feed + stop race +
    # drain grace + lag repair), 250 schedules.
    cargo test -p zen-cli --features shuttle --lib dst_
    # Tier 2a: hosting turn-terminal race (3 completers + duplicate
    # mirror), 320 schedules.
    cargo test -p zen-gateway --features shuttle --lib dst_
    # FR-042 wave: streaming forwarder done/close race, 200 schedules.
    cargo test -p zen-provider --features shuttle --lib dst_
}

pins_gate() {
    # Verified reference impl == runtime SecretMap grammar (plain cargo).
    cargo test -p zen-core --test formal_placeholder
    # Exhaustive frame-split differential (~9000 timelines): incremental
    # restore == whole-string restore for every chunking.
    cargo test -p zen-core --lib differential_split
}

case "${1:-all}" in
verus | --verus-only)
    verus_gate
    ;;
formal)
    verus_gate
    pins_gate
    echo "✅ formal gate green: verus proofs + congruence pins"
    ;;
dst)
    dst_gate
    echo "✅ dst gate green: deterministic schedule sweeps"
    ;;
pins)
    pins_gate
    echo "✅ pins gate green: congruence pins"
    ;;
all)
    verus_gate
    dst_gate
    pins_gate
    echo "✅ verify gate green: verus + dst sweeps + congruence pins"
    ;;
*)
    echo "usage: bin/verify [all|formal|verus|dst|pins|--verus-only]" >&2
    exit 2
    ;;
esac
