#!/bin/bash
#
# Release helper script for zenspace Rust CLI
# Usage: bin/release [major|minor|patch] [version]
#
# Examples:
#   bin/release patch          # Auto-increment patch version (0.1.0 -> 0.1.1)
#   bin/release minor          # Auto-increment minor version (0.1.1 -> 0.2.0)
#   bin/release major          # Auto-increment major version (0.1.1 -> 1.0.0)
#   bin/release 0.2.0          # Use specific version
#   bin/release 0.2.0 dry-run  # Dry run (no commit, no tag, no push)
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
VERSION_FILE="$PROJECT_ROOT/VERSION"
CARGO_TOML="$PROJECT_ROOT/Cargo.toml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if we're in dry-run mode
DRY_RUN=false
if [[ "$2" == "dry-run" ]]; then
    DRY_RUN=true
    log_warn "Dry run mode enabled - no changes will be committed or pushed"
fi

# Get current version
CURRENT_VERSION=$(cat "$VERSION_FILE")
log_info "Current version: v$CURRENT_VERSION"

# Determine new version
if [[ $# -eq 0 ]]; then
    log_error "Usage: bin/release [major|minor|patch] [version] [dry-run]"
    exit 1
fi

case "$1" in
    major)
        IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
        NEW_VERSION="$((MAJOR + 1)).0.0"
        ;;
    minor)
        IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
        NEW_VERSION="$MAJOR.$((MINOR + 1)).0"
        ;;
    patch)
        IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
        NEW_VERSION="$MAJOR.$MINOR.$((PATCH + 1))"
        ;;
    *)
        # Assume explicit version provided
        NEW_VERSION="$1"
        ;;
esac

log_info "New version: v$NEW_VERSION"

# Verify we're on main branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$CURRENT_BRANCH" != "main" && "$CURRENT_BRANCH" != "master" ]]; then
    log_warn "You're on branch '$CURRENT_BRANCH', not main/master"
    read -p "Continue anyway? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Check for uncommitted changes
if [[ -n $(git status --porcelain) ]]; then
    log_warn "You have uncommitted changes"
    read -p "Continue anyway? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Update VERSION file
log_info "Updating VERSION file..."
echo "$NEW_VERSION" > "$VERSION_FILE"

# Update Cargo.toml
log_info "Updating Cargo.toml..."
sed -i.bak "s/^version = \"[^\"]*\"/version = \"$NEW_VERSION\"/" "$CARGO_TOML"
rm -f "$CARGO_TOML.bak"

# Verify changes
log_info "Verifying changes..."
CARGO_VERSION=$(grep '^version = ' "$CARGO_TOML" | head -1 | cut -d'"' -f2)
if [[ "$CARGO_VERSION" != "$NEW_VERSION" ]]; then
    log_error "Version mismatch! Cargo.toml has $CARGO_VERSION but should have $NEW_VERSION"
    exit 1
fi

# Show diff
echo ""
log_info "Changes to be committed:"
git diff

if [[ "$DRY_RUN" == true ]]; then
    log_warn "Dry run complete. Resetting changes..."
    git checkout -- "$VERSION_FILE" "$CARGO_TOML"
    exit 0
fi

# Confirm release
echo ""
read -p "Release v$NEW_VERSION? (y/N): " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    log_warn "Aborted. Resetting changes..."
    git checkout -- "$VERSION_FILE" "$CARGO_TOML"
    exit 1
fi

# Commit and tag
log_info "Creating release commit..."
git add "$VERSION_FILE" "$CARGO_TOML"
git commit -m "release: v$NEW_VERSION"

log_info "Creating git tag..."
git tag "v$NEW_VERSION"

# Push
log_info "Pushing to remote..."
git push origin HEAD
git push origin "v$NEW_VERSION"

echo ""
log_info "✓ Release v$NEW_VERSION created successfully!"
log_info "GitHub Actions will automatically:"
echo "  1. Build binaries for all platforms"
echo "  2. Run tests on all platforms"
echo "  3. Create GitHub Release with packaged binaries"
echo "  4. Publish to crates.io"
echo ""
log_info "Monitor progress: https://github.com/$(git remote get-url origin | sed 's/git@github.com:\(.*\)\.git/\1/' | sed 's/https:\/\/github.com\///')/actions"
